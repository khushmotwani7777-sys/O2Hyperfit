# Environment variables for O2Hyperfit Gym Management System

# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/o2hyperfit?schema=public"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-for-o2hyperfit-production-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Server configuration
NODE_ENV="development"
PORT=3000

# Public application details
NEXT_PUBLIC_APP_NAME="O2Hyperfit"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration
# Options: 'local', 's3', 'cloudinary'
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# Optional Cloud Storage (when STORAGE_PROVIDER is s3 or cloudinary)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET=""
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
